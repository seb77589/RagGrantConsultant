# The ingestion pipeline, containerised so that torch, transformers and
# FlagEmbedding -- around 2.5 GB of wheels -- never land on the host.
#
# Two targets:
#   base   core deps plus the `tokenize` extra -- the real bge-m3 tokenizer,
#          without torch. Enough for fetch, sections, manifest, pytest, ruff.
#          The tokenizer is NOT optional here: chunk boundaries depend on it,
#          and the character fallback over-estimates by ~17%, which silently
#          builds a different corpus than the host does.
#   embed  adds the `embed` extra and runs on CUDA. Needed only for
#          benchmark-embed and the embedding pass.
#
#   docker compose build pipeline            # base
#   docker compose --profile embed build     # embed
#
# Python is pinned to 3.12 because pyproject requires >=3.12,<3.13: the ML
# wheels do not build on 3.13+.

# ---------------------------------------------------------------------------
# base
# ---------------------------------------------------------------------------
FROM python:3.12-slim-trixie AS base

# uv resolves and installs from the committed uv.lock, so the container gets
# the same dependency versions as the host venv rather than a fresh resolution.
# Pinned to the version that generated the committed uv.lock (revision 3).
COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /uvx /usr/local/bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Install into a venv inside the image rather than --system, so the layer
    # is self-contained and nothing depends on the base image's site-packages.
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH" \
    # HuggingFace cache on a named volume. Without this it defaults to
    # ~/.cache/huggingface inside the container and every rebuild re-downloads
    # several GB of weights.
    HF_HOME=/opt/hf

# REPO_ROOT in src/gcr/config.py is Path(__file__).resolve().parents[2], so the
# project must sit at /app with the package at /app/src/gcr for paths to
# resolve. An ordinary (non-editable) install into site-packages would compute
# a root inside the venv instead, and fetch.py would then refuse every
# download: it stores paths relative to REPO_ROOT and raises ValueError for
# anything outside it.
WORKDIR /app

# Dependency layer first, so editing source does not reinstall the world.
# No README copy needed: --no-install-project skips building this package.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev --extra tokenize

COPY README.md ./
COPY src ./src
COPY tests ./tests

# Editable, for the REPO_ROOT reason above.
# Dev tools go in the same layer and must come *after* the sync: `uv sync`
# prunes anything absent from the lock, so installing them earlier would see
# them removed again.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra tokenize \
 && uv pip install pytest ruff

# Run as the invoking user's UID/GID so files written to the bind-mounted
# ./data are owned by them, not by root. Passed from .env via compose build
# args; the defaults match a typical single-user Linux install.
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN groupadd --gid "${HOST_GID}" app 2>/dev/null || true \
 && useradd --uid "${HOST_UID}" --gid "${HOST_GID}" --no-create-home --shell /usr/sbin/nologin app 2>/dev/null || true \
 && mkdir -p /opt/hf /app/data \
 && chown -R "${HOST_UID}:${HOST_GID}" /opt/hf /app

USER ${HOST_UID}:${HOST_GID}

# `gcr` resolves via the venv on PATH. Overridden for pytest and ruff:
#   docker compose run --rm pipeline gcr sections horizon
#   docker compose run --rm --entrypoint pytest pipeline -q
ENTRYPOINT []
CMD ["gcr", "--help"]

# ---------------------------------------------------------------------------
# embed -- adds the GPU stack
# ---------------------------------------------------------------------------
FROM base AS embed

USER root

# ARGs do not cross stage boundaries; re-declare to reuse them in the chown.
ARG HOST_UID=1000
ARG HOST_GID=1000

# torch ships its own CUDA runtime libraries in the wheel, so no CUDA base
# image and no toolkit install is needed: the NVIDIA container runtime injects
# the driver, and that is the only host-side piece.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra embed \
 && uv pip install pytest ruff

RUN chown -R "${HOST_UID}:${HOST_GID}" /opt/venv /opt/hf
USER ${HOST_UID}:${HOST_GID}

CMD ["gcr", "--help"]

# ---------------------------------------------------------------------------
# api -- the HTTP endpoint
# ---------------------------------------------------------------------------
# Built on `base`, not on `embed`: query embedding goes to the TEI service over
# HTTP, so this needs neither torch nor a GPU. The whole image is a few MB more
# than base.
FROM base AS api

USER root

ARG HOST_UID=1000
ARG HOST_GID=1000

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra tokenize --extra api \
 && uv pip install pytest ruff

USER ${HOST_UID}:${HOST_GID}

EXPOSE 8000
# One worker: the bottleneck is the GPU behind the model services, not this
# process, and a second worker would only queue for the same card.
CMD ["uvicorn", "gcr.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
