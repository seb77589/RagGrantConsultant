# Local configuration for the containerised stack.
#
#   cp .env.example .env    then fill in the blanks, or run:
#   ./containers/gen-secrets.sh    which generates .env and secrets/ for you.
#
# .env is gitignored; this template is committed. Image pins are NOT here --
# they live in compose.yaml so that the versions actually used are under
# version control and cannot drift per-machine.

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------

# Prefixes container, network and volume names. Keep it short: volumes appear
# as gcr_pgdata, gcr_hf_cache and so on, which is how Phase 11 tells this
# project's storage apart from the other projects already on this machine.
COMPOSE_PROJECT_NAME=gcr

# Containers log in UTC regardless; this only affects timestamps shown by
# tools inside them. Set it to your local zone if that is easier to read.
TZ=Etc/UTC

# ---------------------------------------------------------------------------
# Host user mapping
# ---------------------------------------------------------------------------

# The pipeline container writes to ./data through a bind mount. Running it as
# your own UID/GID keeps those files owned by you rather than by root, which
# matters because the corpus is checked by host-side tooling too.
#   id -u  /  id -g
HOST_UID=1000
HOST_GID=1000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_USER=gcr
POSTGRES_DB=gcr
# REQUIRED. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Bound to loopback only, for psql and inspection during development. The
# application path never uses it -- services reach the database over the
# compose network as db:5432. Remove the binding entirely to close it.
POSTGRES_HOST_PORT=127.0.0.1:5432

# Authelia stores its sessions and its user metadata in a separate database
# and role on this same instance (one less container, one backup target).
AUTHELIA_DB_NAME=authelia
AUTHELIA_DB_USER=authelia
# REQUIRED. Generate with: openssl rand -base64 32
AUTHELIA_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# bge-m3 is CLS-pooled; compose passes --pooling cls explicitly rather than
# relying on TEI reading it from the repo, because a silent fall-through to
# mean pooling degrades retrieval in a way that just looks like a weak model.
EMBED_MODEL_ID=BAAI/bge-m3
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3

# The generation model, as a GGUF mounted from the gcr_models volume.
# Qwen3.5-9B is a hybrid Gated DeltaNet + MoE model and llama.cpp's support
# for that architecture is young -- see risk R1 in docs/containerisation-plan.md.
# If the Phase 5.0 spike fails, swap these two lines for the fallback and
# record the swap in the plan's run log.
LLM_GGUF_REPO=unsloth/Qwen3.5-9B-GGUF
LLM_GGUF_FILE=Qwen3.5-9B-UD-Q4_K_XL.gguf

# Never the model's native 262144. Reranked retrieval puts 6-10 sections into
# the context, so 16k is ample, and the VRAM budget has no headroom for more:
# see risk R2.
LLM_CTX_SIZE=16384

# ---------------------------------------------------------------------------
# Edge
# ---------------------------------------------------------------------------

# Any *.localhost name makes Caddy issue a certificate from its own local CA.
# That CA must be trusted manually -- Caddy cannot install it into the host
# trust store from inside a container. See risk R3 and step 8.4.
GCR_DOMAIN=grants.localhost
